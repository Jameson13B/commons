rules_version = '2';

// Commons Firestore security rules.
// Model: every member has a doc at users/{uid} with a `role` and `status`.
// - Members can read their own profile and edit only their display name.
// - Moderators+ can read all profiles (for future directory/moderation tools).
// - Only admins can change roles/status or delete members.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function myRole() {
      return isSignedIn() ? userData(request.auth.uid).role : 'guest';
    }

    function myStatus() {
      return isSignedIn() ? userData(request.auth.uid).status : 'pending';
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin' && myStatus() == 'active';
    }

    function isModerator() {
      return isSignedIn()
        && (myRole() == 'moderator' || myRole() == 'admin')
        && myStatus() == 'active';
    }

    // Any approved (active) member, i.e. not a pending guest. Used by the
    // Member Directory so members can see each other.
    function isActiveMember() {
      return isSignedIn() && myStatus() == 'active' && myRole() != 'guest';
    }

    match /users/{uid} {
      // Read your own profile; approved members can read everyone (directory).
      allow read: if isSignedIn() && (request.auth.uid == uid || isActiveMember());

      // New users self-provision as guest/pending only (no privilege escalation).
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'guest'
        && request.resource.data.status == 'pending';

      // Admins can change anything. Owners may edit their profile but NOT
      // their own role or status.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();
    }

    // Announcements: readable by any approved member; only moderators/admins
    // can post, edit, or remove them.
    match /announcements/{id} {
      allow read: if isActiveMember();
      allow create: if isModerator()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000;
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // Events: readable by any approved member; only moderators/admins can
    // schedule, edit, or cancel them. RSVPs live in a subcollection so any
    // active member can respond without needing write access to the event.
    match /events/{id} {
      allow read: if isActiveMember();
      allow create: if isModerator()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.startAt is timestamp;
      allow update: if isModerator();
      allow delete: if isModerator();

      match /rsvps/{uid} {
        allow read: if isActiveMember();
        allow create, update: if isActiveMember()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.status in ['going', 'maybe', 'not_going'];
        // Owners can clear their own RSVP; moderators can remove them when
        // cancelling an event.
        allow delete: if (isActiveMember() && request.auth.uid == uid)
          || isModerator();
      }
    }

    // Records (Community Recorder): official papers, votes, and policies.
    // Published records are readable by any active member; drafts are visible
    // only to admins. Only admins can create, edit, or delete records.
    // NOTE: non-admin clients must query with `where('status','==','published')`
    // so every returned doc satisfies the read rule.
    //
    // Witnessing: once any other active member witnesses a published record
    // (see the `witnesses` subcollection below), it is permanently locked --
    // not even an admin can edit or delete it. Corrections belong in a new
    // record. `witnessCount` denormalizes the subcollection's size onto the
    // parent doc so the lock check here doesn't need a subquery; treat a
    // missing field as zero for records written before this existed.
    function recordWitnessCount() {
      return ('witnessCount' in resource.data) ? resource.data.witnessCount : 0;
    }

    match /records/{id} {
      allow read: if isActiveMember()
        && (resource.data.status == 'published' || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.type in ['paper', 'vote', 'policy']
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.witnessCount == 0;
      allow update: if (isAdmin() && recordWitnessCount() == 0)
        || (
          // Witnessing itself: any active member other than the author may
          // bump the count by exactly one on a published record, and touch
          // nothing else on the doc.
          isActiveMember()
          && resource.data.status == 'published'
          && resource.data.authorUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['witnessCount'])
          && request.resource.data.witnessCount == recordWitnessCount() + 1
        );
      allow delete: if isAdmin() && recordWitnessCount() == 0;

      // Witnesses: an immutable, append-only attestation log. Doc ID is the
      // witnessing member's uid, so a second attempt by the same member lands
      // on `update` (disallowed below) instead of `create`.
      match /witnesses/{uid} {
        allow read: if isActiveMember();
        allow create: if isActiveMember()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/records/$(id)).data.status == 'published'
          && get(/databases/$(database)/documents/records/$(id)).data.authorUid != request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80;
        allow update, delete: if false;
      }
    }

    // Consular Portal: members' travel board (upcoming trips away from
    // Commons, or visitors coming to Commons) and community-contributed
    // travel tips. Both are self-service -- any active member can post; the
    // owner (or a moderator) can edit/delete, and ownership can't be
    // reassigned on update.
    match /consularTrips/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.direction in ['trip', 'visit']
        && request.resource.data.place is string
        && request.resource.data.place.size() > 0
        && request.resource.data.place.size() <= 140
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.startAt is timestamp;
      allow update: if ((isActiveMember() && resource.data.createdBy == request.auth.uid) || isModerator())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if (isActiveMember() && resource.data.createdBy == request.auth.uid)
        || isModerator();
    }

    match /travelTips/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.destination.size() <= 140
        && request.resource.data.tip is string
        && request.resource.data.tip.size() > 0
        && request.resource.data.tip.size() <= 2000;
      allow update: if ((isActiveMember() && resource.data.authorUid == request.auth.uid) || isModerator())
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if (isActiveMember() && resource.data.authorUid == request.auth.uid)
        || isModerator();
    }

    // Future community modules add their own collections/rules below.
  }
}
